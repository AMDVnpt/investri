# Copy to .env at the repo root and to apps/api/.env

DATABASE_URL="postgresql://investri:investri@localhost:5432/investri?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=3001
API_PUBLIC_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3003"
MANAGER_ORIGIN="http://localhost:3002"
COOKIE_SECURE=false

USE_MOCK_KYC=true
USE_MOCK_RESIDENCY=true
USE_MOCK_ELIGIBILITY=true
USE_MOCK_BROKERAGE=true
USE_MOCK_FUNDING=true
USE_MOCK_CUSTODY=true
USE_MOCK_TRANSFER_AGENT=true
USE_MOCK_FUND_ADMIN=true
USE_MOCK_ESIGNATURE=true
USE_MOCK_DOCUMENT=true
USE_MOCK_NOTIFICATION=true
USE_MOCK_TAX_AGENCY=true
USE_MOCK_SSO=true

# Demo seed passwords are for local POC only.
DEMO_PASSWORD="DemoPass123!"
ALLOW_DEMO_RESET=false
