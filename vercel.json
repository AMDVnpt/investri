{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter @investri/admin... build"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "dist/vercel.cjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter @investri/api... build && pnpm --filter @investri/api bundle:vercel",
      "functions": {
        "dist/vercel.cjs": {
          "includeFiles": "dist/**",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/assets/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "admin" } }
  ]
}
